# ============================================
# Cycle Master — .gitignore
# ============================================

# ----------------------------------
# Python
# ----------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
*.whl
.venv/
venv/
env/
.env
.env.*
!.env.example
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ----------------------------------
# Node.js / Vue / Vite
# ----------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
yarn.lock
pnpm-lock.yaml
dist-ssr/
*.local

# Vite
.vite-inspect/

# Nuxt
.nuxt/
.output/

# ----------------------------------
# IDE / Editor
# ----------------------------------
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# VS Code — 保留推荐配置，忽略用户偏好
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json

# ----------------------------------
# OS
# ----------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------------
# 日志
# ----------------------------------
*.log

# ----------------------------------
# 数据库（运行时生成）
# ----------------------------------
data/*.db
data/*.sqlite
data/*.sqlite3

# ----------------------------------
# 数据导出
# ----------------------------------
data/exports/*.csv
data/exports/*.json

# ----------------------------------
# 测试
# ----------------------------------
.pytest_cache/
.pytest_cache/

# ----------------------------------
# Tauri (未来桌面打包)
# ----------------------------------
src-tauri/target/
src-tauri/WixTools/

# ----------------------------------
# Misc
# ----------------------------------
*.bak
*.tmp
*.temp
*.cache
*.swp
.cache/
tmp/
temp/
