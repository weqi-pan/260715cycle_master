# ============================================
# Cycle Master — .gitignore
# ============================================

# ----------------------------------
# Python
# ----------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
develop-eggs/
*.whl
.venv/
venv/
env/
.env
.env.*
!.env.example
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# ----------------------------------
# Node.js / Vue / Vite
# ----------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
dist-ssr/
*.local

# Vite
.vite-inspect/

# Nuxt
.nuxt/
.output/

# ----------------------------------
# IDE / Editor
# ----------------------------------
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# VS Code — keep workspace settings but ignore user prefs
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json
.vscode/

# ----------------------------------
# OS
# ----------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----------------------------------
# Logs & Databases
# ----------------------------------
*.log
*.sqlite
*.sqlite3
*.db

# ----------------------------------
# Tauri (future)
# ----------------------------------
src-tauri/target/
src-tauri/WixTools/

# ----------------------------------
# Misc
# ----------------------------------
*.bak
*.tmp
*.temp
*.cache
*.swp
.cache/
tmp/
temp/
