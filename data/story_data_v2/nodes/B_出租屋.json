    {
      "id": "B_choice_10",
      "label": "在德星路早点铺停一下，再前往华林寺",
      "short_label": "去早点铺",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 91,
      "hint": "蒸笼热气后面，有位老人一直盯着荔湾广场的方向",
      "result_blocks": [
        {
          "id": "B_choice_10.result.paragraph.01.01",
          "type": "narration",
          "text": "街角早点铺的蒸汽漫到骑楼下。你本来只想买份早餐，却注意到最里面那张桌旁坐着一位老人——他面前压着一张保存了二十五年的施工收据。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [],
      "next": {
        "node_id": "S4",
        "mode": "travel"
