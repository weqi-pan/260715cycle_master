    {
      "id": "B_choice_07",
      "label": "检查墙角踢脚线缝隙",
      "short_label": "检查墙角",
      "condition": "and:has_flag:b_hid_under_blanket,cycle>=2",
      "locked_visibility": "hide",
      "repeat_policy": "once_per_visit",
      "priority": 12,
      "hint": "踢脚线缝隙里好像有什么东西在反光",
      "result_blocks": [
        {
          "id": "B_choice_07.result.paragraph.01.01",
          "type": "narration",
          "text": "你蹲在墙角，手指顺着踢脚线的缝隙摸过去。指尖碰到了什么——一片巴掌大的金属，卡在缝隙最深处。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_07.result.paragraph.02.01",
          "type": "narration",
          "text": "你把它抠出来。是一片铜镜的碎片——背面有模糊的八卦纹饰。这片碎片摸起来比房间里的任何东西都凉——冰凉的凉，像刚从深水里捞出来的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_07.result.paragraph.03.01",
          "type": "narration",
          "text": "你拿着碎片站起来。碎片反射出的不是你的脸——是墙壁上那块水渍。在镜面中，那块水渍看起来不像水渍了——像一个女人的侧脸。闭着眼睛。嘴唇微微张开，像在说什么。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "add_item",
          "target": "item_broken_mirror",
          "value": 1
        }
      ],
      "next": {
        "node_id": "B",
        "mode": "stay"
      }
    },
    {
      "id": "B_choice_09",
      "label": "绕道长寿路地铁站，再前往华林寺",
      "short_label": "经过地铁站",
      "condition": "cycle>=2",
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 90,
      "hint": "第二轮起，你开始注意到通勤人群中不协调的身影",
      "result_blocks": [
        {
          "id": "B_choice_09.result.paragraph.01.01",
          "type": "narration",
          "text": "你没有直接去华林寺，而是绕向长寿路地铁站。早高峰的人流从入口不断涌出，唯独站厅深处有一个穿着羽绒服的人，像被遗忘在了另一个季节。",
          "speaker_id": null,
          "when": null
        }
