{
  "schema_version": 2,
  "id": "B",
  "meta": {
    "name": "德星路出租屋",
    "node_type": "main",
    "position": 25.0,
    "time_label": "第一天·深夜 23:00-03:00",
    "parent_node_id": null,
    "trigger_condition": null
  },
  "scene": {
    "background": null,
    "palette": "墨蓝+灰白",
    "ambient": null,
    "atmosphere": [
      "孤独",
      "被注视感",
      "寒意",
      "历史的第一次低语"
    ]
  },
  "entry_sequences": [
    {
      "id": "B.entry.default",
      "when": null,
      "priority": 0,
      "blocks": [
        {
          "id": "B.entry.default.paragraph.01.01",
          "type": "narration",
          "text": "房间约十五平方米。进门左手边是关不严的衣柜，右手边一张单人床。正对门的窗户——两扇老式钢窗，玻璃上有一层擦不掉的灰蒙蒙的膜。窗户正对着荔湾广场北塔。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.02.01",
          "type": "narration",
          "text": "北塔在月光下的轮廓像一口横卧的巨大棺材。零星的几扇窗户亮着灯——大部分住户早已搬走。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.03.01",
          "type": "narration",
          "text": "靠窗放着一张复合板书桌，桌面被烫出几个圆形的杯印。床头柜上一个搪瓷水杯，杯底还残留着没擦干的水痕。墙皮剥落，露出灰黄色砂浆。空气中有淡淡的霉味。月租六百。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.04.01",
          "type": "narration",
          "text": "水龙头偶尔发出'咯——咯——'的怪声。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.05.01",
          "type": "narration",
          "text": "---",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.06.01",
          "type": "narration",
          "text": "凌晨一点。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.07.01",
          "type": "narration",
          "text": "墙外传来哭喊声。不是普通话，不是粤语——更古老的口音，明末清初的官话夹杂着南方方言。男女老少都有，从墙壁的每一寸表面渗透进来。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.08.01",
          "type": "narration",
          "text": "玻璃上开始浮现手印。雾气凝结成的，大大小小——成年人的，孩子的。它们从玻璃内侧缓慢浮现，像有什么看不见的东西正用手掌贴着玻璃，从里往外推。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.09.01",
          "type": "narration",
          "text": "床头柜上的搪瓷杯里，水面在震动。一圈一圈的涟漪从杯心向外扩散，然后消失，再出现。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.default.paragraph.10.01",
          "type": "narration",
          "text": "_它想出去？还是想进来？_",
          "speaker_id": null,
          "when": null
        }
      ]
    },
    {
      "id": "B.entry.cycle_2",
      "when": "cycle==2",
      "priority": 20,
      "blocks": [
        {
          "id": "B.entry.cycle_2.paragraph.01.01",
          "type": "narration",
          "text": "你再次站在这间十五平米的房间里。钥匙还是那把——匙柄上的'502'贴纸已经卷起了边。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.cycle_2.paragraph.02.01",
          "type": "narration",
          "text": "窗户正对着的北塔在月光下沉默着。但你注意到了——五楼那扇窗户。上一轮它只是亮着灯。这一轮——它亮着，而且有什么东西在里面动了一下。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.cycle_2.paragraph.03.01",
          "type": "narration",
          "text": "_（它在靠近。每一次循环，近一层楼。）_",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.cycle_2.paragraph.04.01",
          "type": "narration",
          "text": "房间的角落里，墙壁上的水渍形状有些眼熟——你确定上一轮它不在那个位置。那水渍看起来像一张侧脸。不——可能只是墙皮剥落的巧合。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.cycle_2.paragraph.05.01",
          "type": "narration",
          "text": "可能是。",
          "speaker_id": null,
          "when": null
        }
      ]
    },
    {
      "id": "B.entry.cycle_3+",
      "when": "cycle>=3",
      "priority": 30,
      "blocks": [
        {
          "id": "B.entry.cycle_3+.paragraph.01.01",
          "type": "narration",
          "text": "第{{cycle_count}}次了。你甚至不用开灯就能走完从门口到床边的距离。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.cycle_3+.paragraph.02.01",
          "type": "narration",
          "text": "房间在等——你感觉得到。它不再是一个出租屋，它是一个观察站。那些墙壁在过去的循环中吸收了什么，正在缓慢地释放出一种黏稠的、无法名状的存在感。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.cycle_3+.paragraph.03.01",
          "type": "narration",
          "text": "窗外的北塔现在不是'像棺材'——你已经习惯了。你习惯了它带来的恐怖，这正是问题所在。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B.entry.cycle_3+.paragraph.04.01",
          "type": "narration",
          "text": "床底下比上一轮更暗了。你尽量不看那个方向。但你知道——你也知道——它也在等。",
          "speaker_id": null,
          "when": null
        }
      ]
    }
  ],
  "choices": [
    {
      "id": "B_choice_01",
      "label": "打开窗户查看外面到底发生了什么",
      "short_label": "打开窗户",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 1,
      "hint": "窗外的北塔里，有什么东西在动",
      "result_blocks": [
        {
          "id": "B_choice_01.result.paragraph.01.01",
          "type": "narration",
          "text": "窗户的把手冰凉得刺手。你用力一推——老化的金属铰链发出一声刺耳的尖叫。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_01.result.paragraph.02.01",
          "type": "narration",
          "text": "窗外的北塔轮廓在月光下仍然像一口横卧的棺材。但你看到了——北塔四楼的某扇窗户里，一个白色的身影一闪而过。不是走过去的——是飘的。悬在半空中，没有脚，没有重量。它在窗框内停留了大约两秒——你看到了一张模糊的脸，五官被月光漂白得看不清楚——然后它穿过了墙壁，消失在相邻的房间中。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_01.result.paragraph.03.01",
          "type": "narration",
          "text": "雾气手印从玻璃上飘了出来——像是被打开了封口，白色的水汽从手印形状的痕迹中升腾起来，在你面前短暂地凝聚成了一个人形的轮廓——然后散开了。水汽落在你脸上，冰凉的，带着一种混合了檀香和铁锈的气息。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_01.result.paragraph.04.01",
          "type": "narration",
          "text": "此后——这扇窗户在每一轮循环中都会亮着灯。北塔的那扇窗户。不管白天黑夜。即使整栋北塔的灯都熄了，那扇窗还是亮着的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_01.result.paragraph.05.01",
          "type": "narration",
          "text": "你注意到白影的位置——它比上一轮近了。离你的窗户又近了一层。它在向你靠近。",
          "speaker_id": null,
          "when": "cycle>=2"
        }
      ],
      "effects": [
        {
          "type": "heal",
          "target": "courage",
          "value": 2
        },
        {
          "type": "damage",
          "target": "sanity",
          "value": 3
        },
        {
          "type": "set_flag",
          "target": "ghost_lady_seen",
          "value": true
        }
      ],
      "next": {
        "node_id": "B",
        "mode": "stay"
      }
    },
    {
      "id": "B_choice_02",
      "label": "蒙上被子——不听、不看、不回应",
      "short_label": "蒙头不管",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 2,
      "hint": "也许天亮了一切就结束了",
      "result_blocks": [
        {
          "id": "B_choice_02.result.paragraph.01.01",
          "type": "narration",
          "text": "你把被子蒙过头顶。夏被很薄，但你把它裹得紧紧的——像小时候以为只要被子里就是安全的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_02.result.paragraph.02.01",
          "type": "narration",
          "text": "外面的哭喊声被被子过滤得闷了一些，但依然清晰。你闭上眼睛，咬紧牙关。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_02.result.paragraph.03.01",
          "type": "narration",
          "text": "_（不要听。不要想。天亮了一切就好了。）_",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_02.result.paragraph.04.01",
          "type": "narration",
          "text": "不知道过了多久——也许五分钟，也许二十分钟——声音消失了。你掀开被子，房间里一切如常。日光灯依旧嗡嗡响。搪瓷杯里的水恢复了平静。窗户上的手印已经消退得无影无踪。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_02.result.paragraph.05.01",
          "type": "narration",
          "text": "你活过了今晚。但你知道——有一些变化已经开始了。房间的角落似乎比事件之前更暗了一些。墙壁上的阴影边缘更深了。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_02.result.paragraph.06.01",
          "type": "narration",
          "text": "现在你可以搜索房间了。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "set_flag",
          "target": "b_hid_under_blanket",
          "value": true
        }
      ],
      "next": {
        "node_id": "B",
        "mode": "stay"
      }
    },
    {
      "id": "B_choice_03",
      "label": "打开手机录音功能——记录下这个声音",
      "short_label": "打开手机录音",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 3,
      "hint": "可能会有用的线索",
      "result_blocks": [
        {
          "id": "B_choice_03.result.paragraph.01.01",
          "type": "narration",
          "text": "你掏出手机——手在发抖，花了两次才解锁屏幕——点开录音APP，按下那个红色的圆点。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_03.result.paragraph.02.01",
          "type": "narration",
          "text": "手机屏幕上的声波开始跳动。你把它举高，对准窗户的方向。录了大约四十秒。哭喊声在录音的最初几秒最清晰——然后开始掺杂进一些别的声音：马蹄铁在石板路上敲击的声音。金属碰撞——像盔甲的甲片在摩擦。火烧木头的噼啪声。远处某个人在中气十足地喊着什么——是指令，不是哭喊。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_03.result.paragraph.03.01",
          "type": "narration",
          "text": "_这些声音不是从窗外传来的。它们像是在墙内部——在这栋楼的砖缝里，在三百年来的每一层涂料之下。_",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_03.result.paragraph.04.01",
          "type": "narration",
          "text": "录音结束。回放时——声音比实际听到的更清晰。手机的话筒没有耳朵会害怕，它忠实地记录了一切。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "heal",
          "target": "courage",
          "value": 1
        },
        {
          "type": "damage",
          "target": "sanity",
          "value": 1
        },
        {
          "type": "set_flag",
          "target": "b_recorded_wall_sound",
          "value": true
        }
      ],
      "next": {
        "node_id": "B",
        "mode": "stay"
      }
    },
    {
      "id": "B_choice_04",
      "label": "床底下……是不是比刚才更暗了？",
      "short_label": "检查床底深处",
      "condition": "and:cycle>=3,has_flag:knew_previous_tenant",
      "locked_visibility": "hide",
      "repeat_policy": "once_per_visit",
      "priority": 0,
      "hint": "那里面有什么东西缩在墙角。它很害怕——它在害怕你",
      "result_blocks": [
        {
          "id": "B_choice_04.result.paragraph.01.01",
          "type": "narration",
          "text": "你趴在地板上，脸贴着冰凉的地砖，往床底深处看去。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_04.result.paragraph.02.01",
          "type": "narration",
          "text": "床底比正常的床底深得多。深得不对劲——这栋楼的地面到床架底部最多也就二十厘米的空间，但你看到的黑暗向远处延伸着，像一个没有尽头的通道。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_04.result.paragraph.03.01",
          "type": "narration",
          "text": "在那片不该存在的黑暗中——有什么东西缩在墙角。不是老鼠。是一个人形的东西。缩成一团，膝盖顶着胸口，双臂抱着头。你看不清它的脸——但你能看到它在极轻微地呼吸。肩膀缓慢地起伏着。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_04.result.paragraph.04.01",
          "type": "narration",
          "text": "_它也在害怕。它害怕的不是床底的黑暗——它害怕的是你。_",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_04.result.paragraph.05.01",
          "type": "narration",
          "text": "然后那东西动了一下。它的头——以一种不该出现在人类身上的角度——慢慢地转了过来。然后你的手电筒突然灭了。黑暗中，你听到了它的呼吸声。就在你的耳边。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "damage",
          "target": "sanity",
          "value": 5
        },
        {
          "type": "heal",
          "target": "courage",
          "value": 1
        },
        {
          "type": "set_flag",
          "target": "bed_entity_encountered",
          "value": true
        }
      ],
      "next": {
        "node_id": "B",
        "mode": "stay"
      }
    },
    {
      "id": "B_choice_05",
      "label": "搜索床底角落",
      "short_label": "搜索床底",
      "condition": "has_flag:b_hid_under_blanket",
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 10,
      "hint": null,
      "result_blocks": [
        {
          "id": "B_choice_05.result.paragraph.01.01",
          "type": "narration",
          "text": "床底下积了一层薄灰。你用手电筒照着扫过去——角落里有一张黄色的便签纸，被揉皱了又展开。上面用圆珠笔写了三遍同一句话：",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_05.result.paragraph.02.01",
          "type": "narration",
          "text": "> 不要看窗外\n> 不要看窗外\n> 不要看窗外",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_05.result.paragraph.03.01",
          "type": "narration",
          "text": "第一遍是端正的楷书。第二遍笔迹开始潦草。第三遍几乎划穿了纸——字迹歪斜，力透纸背。便签纸的背面还有一行更小的字：",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_05.result.paragraph.04.01",
          "type": "narration",
          "text": "> 对不起我没忍住。第一晚就看了。它记住我了。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "add_item",
          "target": "item_warning_note",
          "value": 1
        },
        {
          "type": "damage",
          "target": "sanity",
          "value": 1
        },
        {
          "type": "set_flag",
          "target": "knew_previous_tenant",
          "value": true
        }
      ],
      "next": {
        "node_id": "B",
        "mode": "stay"
      }
    },
    {
      "id": "B_choice_06",
      "label": "搜索衣柜顶部",
      "short_label": "搜索衣柜",
      "condition": "has_flag:b_hid_under_blanket",
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 11,
      "hint": null,
      "result_blocks": [
        {
          "id": "B_choice_06.result.paragraph.01.01",
          "type": "narration",
          "text": "衣柜顶部积了厚厚一层灰。你踮起脚尖摸到了一卷发黄发脆的东西——一份剪报，从1993年9月的《广州日报》上剪下来的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_06.result.paragraph.02.01",
          "type": "narration",
          "text": "标题：**荔湾广场工地发生不明塌方 三名工人失踪**",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_06.result.paragraph.03.01",
          "type": "narration",
          "text": "> 本报讯 昨日下午，荔湾广场施工工地B1层发生局部塌方。据现场工人称，施工中发现了不明地下空间，内有砖石结构。施工方随即进行了回填处理。然而回填后三名工人下落不明。\n>\n> 一名不愿透露姓名的工人称：\"挖到的东西不正常。不是墓，比墓深得多。墙上的砖是清朝的，但砖缝里的灰浆还没干。\"",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "B_choice_06.result.paragraph.04.01",
          "type": "narration",
          "text": "剪报被谁放在这里的？上一位租客？还是更早的人？502室的月租是六百——在这个地段，便宜得不正常。你已经开始明白为什么了。",
          "speaker_id": null,
          "when": null
        }
      ],
