  "entry_sequences": [
    {
      "id": "H.entry.default",
      "when": null,
      "priority": 0,
      "blocks": [
        {
          "id": "H.entry.default.paragraph.01.01",
          "type": "narration",
          "text": "康王路在深夜中安静得不像一条主干道。路灯间隔很远——每隔两盏就有一盏不亮。榕树的气根在夜风中缓慢摇晃，在路面上投下密密麻麻的、像手指一样的影子。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.02.01",
          "type": "narration",
          "text": "你沿着康王路朝荔湾广场正门方向走。每一步都踩在\"结束\"的边缘——你知道走到正门，这一轮循环就结束了。四天的记忆将被重置。你获得的信息、道具、flag——那些跨循环的会保留。那些不跨循环的会消失。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.03.01",
          "type": "narration",
          "text": "路边有一家24小时便利店。白色的日光灯管在深夜中格外刺眼。门口的报架上——《南方都市报》的日期永远是7月15日。今天的头条是\"地铁三号线延长线今日开通\"。上次的头条是\"广州足球队晋级亚冠\"。每一次循环，头条都不同——但日期不变。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.04.01",
          "type": "narration",
          "text": "---",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.05.01",
          "type": "narration",
          "text": "电线杆下散落着几片未烧尽的冥纸。道教符文的残片在微风中轻轻翻动。有人在今晚烧过纸——为了镇压地下的什么东西。纸灰还是温的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.06.01",
          "type": "narration",
          "text": "离正门还有三百米。你可以看到广场穹顶的轮廓了——在月光下，它的弧线像一口倒扣的钟。或者像一只闭着的眼睛。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.07.01",
          "type": "narration",
          "text": "---",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.08.01.narration",
          "type": "narration",
          "text": "张天民站在康王路中段的一盏路灯下，手里拿着他的笔记本。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.08.02.dialogue",
          "type": "dialogue",
          "text": "我在等你。",
          "speaker_id": "npc_zhang_tianmin",
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.08.03.narration",
          "type": "narration",
          "text": "他说。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.08.04.dialogue",
          "type": "dialogue",
          "text": "今天是第55天——我的。我想我知道怎么把笔记交给你了。",
          "speaker_id": "npc_zhang_tianmin",
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.09.01.narration",
          "type": "narration",
          "text": "他递过来一本A5大小的软皮笔记本——八十页。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.default.paragraph.09.02.dialogue",
          "type": "dialogue",
          "text": "我在第一页就写了：'如果你看到这个，说明我失败了。但你还有机会。'",
          "speaker_id": "npc_zhang_tianmin",
          "when": null
        }
      ]
    },
    {
      "id": "H.entry.cycle_2",
      "when": "cycle==2",
      "priority": 20,
      "blocks": [
        {
          "id": "H.entry.cycle_2.paragraph.01.01",
          "type": "narration",
          "text": "你又走在康王路上。便利店还在——报架上的头条又变了。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.cycle_2.paragraph.02.01.narration",
          "type": "narration",
          "text": "张天民在路灯下等你。这次他手里没有笔记本——他给你看了手机备忘录。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.cycle_2.paragraph.02.02.dialogue",
          "type": "dialogue",
          "text": "我试过了。我把所有东西写在纸上，循环重置后纸上的字还在——但位置变了。它不从笔尖流到纸上——它从纸的背面浮现出来。",
          "speaker_id": "npc_zhang_tianmin",
          "when": null
        },
        {
          "id": "H.entry.cycle_2.paragraph.03.01.narration",
          "type": "narration",
          "text": "他翻到笔记本最后一页——上面的字歪歪扭扭的，像是从纸张内部渗透出来的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.cycle_2.paragraph.03.02.dialogue",
          "type": "dialogue",
          "text": "每一次循环，已有的记录不会被清除——它们只是被‘推到’了下一页。",
          "speaker_id": "npc_zhang_tianmin",
          "when": null
        }
      ]
    },
    {
      "id": "H.entry.cycle_3+",
      "when": "cycle>=3",
      "priority": 30,
      "blocks": [
        {
          "id": "H.entry.cycle_3+.paragraph.01.01",
          "type": "narration",
          "text": "第{{cycle_count}}次走完康王路。你已经不需要数步数了。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.cycle_3+.paragraph.02.01",
          "type": "narration",
          "text": "便利店、报纸、冥纸、张天民的笔记本——这一切构成了\"循环的最后一段\"。你知道正门在等你。你知道跨过正门后你会再次站在德星路9号门前，手机上的时间还是7月15日18:30。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.cycle_3+.paragraph.03.01",
          "type": "narration",
          "text": "你掏出手机，打开备忘录。你开始打字——用程序员的思维方式，把四天四夜中获得的每一条线索整理成结构化数据：",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "H.entry.cycle_3+.paragraph.04.01",
          "type": "narration",
          "text": "> 八棺阵 = 时间裂隙的物理封印\n> 龙脉 = 时间裂隙的能量来源\n> J节点 = 空间捷径（半循环）\n> K节点 = 时间跃迁（完整重启）\n> 献祭道具 = 修复封印的能量",
          "speaker_id": null,
          "when": null
        }
      ]
    }
  ],
