  },
  "entry_sequences": [
    {
      "id": "S10.entry.default",
      "when": null,
      "priority": 0,
      "blocks": [
        {
          "id": "S10.entry.default.paragraph.01.01",
          "type": "narration",
          "text": "珠江轮渡码头在傍晚时分已经没什么人了。末班轮渡在二十分钟前就开了——现在码头上只剩下一个售票窗口还亮着灯。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S10.entry.default.paragraph.02.01",
          "type": "narration",
          "text": "售票员不在窗口后面。售票窗口的缝隙里卡着一张旧船票——粉红色的老版式。这种票已经在2005年就停用了。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S10.entry.default.paragraph.03.01",
          "type": "narration",
          "text": "船票上的座位号是13A。票面没有任何检票的痕迹——这张票被买下来，然后被遗忘在了售票窗口的缝隙里。买票的人去了哪里？",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S10.entry.default.paragraph.04.01",
          "type": "narration",
          "text": "渡口的栏杆上系着几根红绳——有些已经褪色了，有些还很新。这是广州的习俗——有人在渡口许了愿。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S10.entry.default.paragraph.05.01",
          "type": "narration",
          "text": "江风吹过来——带着水汽和柴油味。对岸的灯火在水面上拉成一条条颤动的光线。如果你盯着水面看太久——你会看到那些光线开始组成图案。不是随机的图案——是城墙的轮廓。1650年的广州城墙。",
          "speaker_id": null,
          "when": null
        }
      ]
    }
  ],
  "choices": [
    {
      "id": "S10_choice_01",
      "label": "取出售票窗口缝隙里的旧船票",
      "short_label": "取船票",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 1,
      "hint": "这张票从来没有被用过",
      "result_blocks": [
        {
          "id": "S10_choice_01.result.paragraph.01.01",
          "type": "narration",
          "text": "你用指甲小心地把船票从窗口缝隙里挑出来。纸质比想象中更脆——粉红色的票面在指尖下微微颤动，像是刚从打印机里吐出来的，而不是被遗忘在这里二十年。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S10_choice_01.result.paragraph.02.01",
          "type": "narration",
          "text": "票面印刷的时间是2005年7月15日。又是7月15日。座位号13A——这个座位号你似乎在什么地方见过，但想不起来。票根完好，没有被撕过的痕迹。买票的人从未登上那班船。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S10_choice_01.result.paragraph.03.01",
          "type": "narration",
          "text": "_（这张船票不是被遗忘的——是被留下的。有人买了一张不会登上的船——像是在等什么人，或者——在标记什么。）_",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "add_item",
          "target": "item_ferry_ticket",
          "value": 1
        }
      ],
      "next": {
        "node_id": "S10",
        "mode": "stay"
      }
    },
    {
      "id": "S10_choice_02",
      "label": "离开码头",
      "short_label": "离开",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 99,
      "hint": null,
      "result_blocks": [
        {
          "id": "S10_choice_02.result.paragraph.01.01",
          "type": "narration",
          "text": "你最后望了一眼江面——对岸灯光组成的城墙轮廓已经消散，只余下普通的水波反光。你转身离开码头，渡口的红绳在夜风里轻轻摇晃，像无数只没有送出去的手。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [],
      "next": {
        "node_id": "F",
        "mode": "travel"
      }
    }
