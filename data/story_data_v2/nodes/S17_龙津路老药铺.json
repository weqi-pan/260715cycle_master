  "entry_sequences": [
    {
      "id": "S17.entry.default",
      "when": null,
      "priority": 0,
      "blocks": [
        {
          "id": "S17.entry.default.paragraph.01.01",
          "type": "narration",
          "text": "龙津路这家老药铺开了将近一百年——和上下九步行街的历史一样长。药柜是紫檀木打的，几百个小抽屉上贴着毛笔写的药名——很多药名还用的是繁体字。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S17.entry.default.paragraph.02.01",
          "type": "narration",
          "text": "老中医已经准备打烊了——但他看到你时，手上的动作停了。他盯着你的脸看了好几秒。不是看病人——是看一个\"被什么东西跟着\"的人。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S17.entry.default.paragraph.03.01.dialogue",
          "type": "dialogue",
          "text": "你最近——睡得不太好吧。",
          "speaker_id": "npc_old_doctor",
          "when": null
        },
        {
          "id": "S17.entry.default.paragraph.03.02.narration",
          "type": "narration",
          "text": "他说。不是疑问句。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S17.entry.default.paragraph.04.01",
          "type": "narration",
          "text": "他没等你回答，转身拉开几个药柜——酸枣仁、茯苓、远志、合欢皮——抓了七味安神药材，用黄纸包好，系上红棉线。然后他犹豫了一下——又多抓了一味放进去。那一味不在方子上。是朱砂。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S17.entry.default.paragraph.05.01.dialogue",
          "type": "dialogue",
          "text": "这个——不收钱。",
          "speaker_id": "npc_old_doctor",
          "when": null
        },
        {
          "id": "S17.entry.default.paragraph.05.02.narration",
          "type": "narration",
          "text": "他把药包推到你面前。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S17.entry.default.paragraph.05.03.dialogue",
          "type": "dialogue",
          "text": "喝完那晚——你耳边那个嗡嗡声会停一会儿。不长。但够你喘口气了。",
          "speaker_id": "npc_old_doctor",
          "when": null
        }
      ]
    }
  ],
  "choices": [
    {
      "id": "S17_choice_01",
      "label": "收下老中医的安神药包",
      "short_label": "收药包",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 1,
      "hint": null,
      "result_blocks": [
        {
          "id": "S17_choice_01.result.paragraph.01.01",
          "type": "narration",
          "text": "你接过黄纸包好的药包。纸包温热——老中医的手掌温度透过七层黄纸传到你手心里。朱砂在药包深处散发出淡淡的矿物腥味——不像药材的味道，更像是庙里香炉的灰，或者德星路那个神龛上陈年符纸的气息。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S17_choice_01.result.paragraph.02.01",
          "type": "narration",
          "text": "老中医看着你收下药包，微微点了点头。他没有再说别的。但他转身关药柜的时候——你的余光扫到朱砂抽屉的角落里压着一叠用红纸折的符咒，和你在德星路神龛看到的一模一样。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "add_item",
          "target": "item_anshen_herb",
          "value": 1
        }
      ],
      "next": {
        "node_id": "S17",
        "mode": "stay"
      }
    },
    {
      "id": "S17_choice_02",
      "label": "离开药铺",
      "short_label": "离开",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 99,
      "hint": null,
      "result_blocks": [
        {
          "id": "S17_choice_02.result.paragraph.01.01",
          "type": "narration",
          "text": "你推开药铺的木门。龙津路的夜风裹着中药铺里特有的药香——当归、陈皮、茯苓——飘散在街巷里。走了几步回头——老中医已经关了灯。药铺的木质招牌在路灯下只留下一个深色的剪影。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [],
      "next": {
        "node_id": "H",
        "mode": "travel"
      }
    }
