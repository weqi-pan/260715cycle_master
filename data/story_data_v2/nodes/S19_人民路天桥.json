        "mode": "stay"
      }
    },
    {
      "id": "S19_choice_02",
      "label": "离开天桥",
      "short_label": "离开",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 99,
      "hint": null,
      "result_blocks": [
        {
          "id": "S19_choice_02.result.paragraph.01.01",
          "type": "narration",
          "text": "你离开那个特殊的角度。荔湾广场的影像恢复了正常——至少看起来恢复了正常。人民路天桥上的风突然变得很冷，像是从某个不该有出口的地方吹过来的。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [],
