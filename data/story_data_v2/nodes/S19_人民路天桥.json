  "entry_sequences": [
    {
      "id": "S19.entry.default",
      "when": null,
      "priority": 0,
      "blocks": [
        {
          "id": "S19.entry.default.paragraph.01.01",
          "type": "narration",
          "text": "人民路天桥的位置很特殊——它正好处在荔湾广场的西北方向，横跨在一条主干道上。从天桥上往东看，能看到荔湾广场的全貌——正门、北塔、南塔、穹顶——完整的轮廓。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S19.entry.default.paragraph.02.01",
          "type": "narration",
          "text": "但今天晚上——所有的东西看起来都有些偏移。北塔的轮廓似乎比平时窄了一点。正门的铜狮不在原本的位置——它往左移了大约半米。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S19.entry.default.paragraph.03.01",
          "type": "narration",
          "text": "不是建筑被移动了。是你看它的角度变了。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S19.entry.default.paragraph.04.01",
          "type": "narration",
          "text": "你走遍了天桥的每一段——在东侧中段的位置，你找到了一个特殊的角度。站在那里——你能同时看到荔湾广场正门和它在人民路高架桥玻璃幕墙上的反光。两个画面重叠在一起——形成了一个莫比乌斯环的拓扑形状。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S19.entry.default.paragraph.05.01",
          "type": "narration",
          "text": "_（这不是偶然的。有人设计了这个角度——让你从这里能看到循环的形状。）_",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S19.entry.default.paragraph.06.01",
          "type": "narration",
          "text": "桥栏杆上有一行被磨得快看不清的刻字：\"我也看到你了。——第13轮\"",
          "speaker_id": null,
          "when": null
        }
      ]
    }
  ],
  "choices": [
    {
      "id": "S19_choice_01",
      "label": "站在那个特殊角度观察莫比乌斯拓扑",
      "short_label": "观察拓扑",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 1,
      "hint": "两个画面重叠——形成了莫比乌斯环的拓扑形状",
      "result_blocks": [
        {
          "id": "S19_choice_01.result.paragraph.01.01",
          "type": "narration",
          "text": "你站在那个位置不动。荔湾广场正门的影像和它在高架桥玻璃幕墙上的反光叠在一起——两个画面不是镜像关系。正门是现在的——反光里是稍微早一点的——然后反光里的画面又反光回广场正门上——时间在玻璃上折叠。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S19_choice_01.result.paragraph.02.01",
          "type": "narration",
          "text": "你盯着这个重叠的拓扑看了整整几分钟。莫比乌斯环——时间的开始和结束在同一个平面上，没有起点，也没有终点。每一次你以为自己走出了循环——你只是走回了出发的那一侧。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S19_choice_01.result.paragraph.03.01",
          "type": "narration",
          "text": "_（有人特意设计了这个角度。第13轮的那个人——他不是在开玩笑。他用这面玻璃幕墙作为视觉装置——告诉所有被困在这里的人：你看——这就是你现在的处境。你走在莫比乌斯环上。看到这个信息的人——至少不是孤独的。）_",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "set_flag",
          "target": "saw_loop_boundary",
          "value": true
        },
        {
          "type": "heal",
          "target": "sanity",
          "value": 3
        }
      ],
      "next": {
