    "atmosphere": []
  },
  "entry_sequences": [
    {
      "id": "S20.entry.default",
      "when": null,
      "priority": 0,
      "blocks": [
        {
          "id": "S20.entry.default.paragraph.01.01",
          "type": "narration",
          "text": "锦纶会馆是广州现存最完整的清代行业会馆——建于雍正年间，原是丝绸商人的聚会场所。现在它被夹在两栋现代高层之间——像一颗被遗忘在牙缝里的米粒。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20.entry.default.paragraph.02.01",
          "type": "narration",
          "text": "会馆的庭院里有一口老井。井口被铁栅栏封着——但铁栅栏的锁是开的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20.entry.default.paragraph.03.01",
          "type": "narration",
          "text": "井水在深处泛着幽暗的光。如果你趴在井口往下看——能看到水面倒映出的不是你的脸。是一个穿清朝官服的人的脸——在井底仰头看着你。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20.entry.default.paragraph.04.01",
          "type": "narration",
          "text": "_（这口井在地下连通着龙脉。井水从时间裂隙中流过——带着不同时间层的信息。）_",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20.entry.default.paragraph.05.01",
          "type": "narration",
          "text": "如果你打一桶水上来——它会比正常的井水凉得多。凉到能冻伤手指。这是从时间裂隙中渗出的\"原水\"——不是饮水用的。是用来\"清洗\"的。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20.entry.default.paragraph.06.01",
          "type": "narration",
          "text": "用它洗一把脸——你能暂时看到平时看不到的东西。持续大约一个时辰。但每一轮只能使用一次——第二次用就没效果了。",
          "speaker_id": null,
          "when": null
        }
      ]
    }
  ],
  "choices": [
    {
      "id": "S20_choice_01",
      "label": "打一桶古井水洗脸",
      "short_label": "打水洗脸",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 1,
      "hint": "井水很冷——冷到骨头里。洗完脸之后，你暂时能\"看到\"平时看不到的东西。",
      "result_blocks": [
        {
          "id": "S20_choice_01.result.paragraph.01.01",
          "type": "narration",
          "text": "你用井边的铁桶放下绳子。桶碰到水面——发出一种异常的清脆回音，像是敲钟——不是水声，是金属敲击在很深很深的空洞里的声音。往上拉的时候，桶的重量超过你的预期——这水的密度太大了。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20_choice_01.result.paragraph.02.01",
          "type": "narration",
          "text": "你把水捧起来——双手立刻被冻得发白。不是冬天的冷——是一种深入骨髓的寒，像是手伸进了时间裂缝里。你咬紧牙关把水拍到脸上——一瞬间，整个世界变了样。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20_choice_01.result.paragraph.03.01",
          "type": "narration",
          "text": "_（你看到了——龙脉在地板下方三丈处流过，像一条被囚禁的发光河流。会馆的墙壁上叠印着无数前人的面孔——丝绸商人、举人老爷、民国学生——每一个来过锦纶会馆的人都在这里留下了时间的痕迹。）_",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S20_choice_01.result.paragraph.04.01",
          "type": "narration",
          "text": "_（在最里面的角落里——正对着井口的东侧——一个穿着清朝五品官服的老人盘腿坐在蒲团上。他闭着眼睛——但眉心在发光。陈德修，咸丰十一年自愿入定镇守龙脉节点。一百六十余年来未曾离开。他感觉到你在看他——微微睁开眼。向你点了一下头——然后重新闭上了眼睛。）_",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [
        {
          "type": "heal",
          "target": "sanity",
          "value": 5
        }
      ],
      "next": {
        "node_id": "S20",
        "mode": "stay"
      }
    },
    {
      "id": "S20_choice_02",
      "label": "离开会馆",
      "short_label": "离开",
      "condition": null,
      "locked_visibility": "show",
      "repeat_policy": "once_per_visit",
      "priority": 99,
      "hint": null,
      "result_blocks": [
        {
          "id": "S20_choice_02.result.paragraph.01.01",
          "type": "narration",
          "text": "你没有碰那桶水。井底的水面还在黑暗中泛着幽光——那个清朝官员的脸还倒映在水面上，仰着头从井底看着你。你慢慢退出庭院，轻轻带上会馆的木门。身后传来井水深处的一声轻微响动——像是有人在井底叹了口气。",
          "speaker_id": null,
          "when": null
        }
      ],
      "effects": [],
      "next": {
        "node_id": "G",
        "mode": "travel"
      }
    }
