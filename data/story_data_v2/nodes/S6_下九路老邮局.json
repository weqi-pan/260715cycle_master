  "entry_sequences": [
    {
      "id": "S6.entry.default",
      "when": null,
      "priority": 0,
      "blocks": [
        {
          "id": "S6.entry.default.paragraph.01.01",
          "type": "narration",
          "text": "下九路这家老邮局已经开了将近一百年。木质柜台被磨得发亮，墙上的老式挂钟还在嘀嗒走动——虽然时间已经不准了。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.02.01",
          "type": "narration",
          "text": "燕妍径直走到\"逾期邮件\"的玻璃柜前——里面锁着一些因为地址不详、收件人已故等原因永远无法送达的信件。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.03.01.dialogue",
          "type": "dialogue",
          "text": "你看这封——",
          "speaker_id": "npc_yan_yan",
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.03.02.narration",
          "type": "narration",
          "text": "她指着最角落的一个泛黄信封。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.04.01",
          "type": "narration",
          "text": "信封上：寄信人——陈伯陶。收信人——陈水生（转交）。邮戳日期——1925年3月15日。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.05.01.dialogue",
          "type": "dialogue",
          "text": "这封信在这里等了一百年。",
          "speaker_id": "npc_yan_yan",
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.05.02.narration",
          "type": "narration",
          "text": "燕妍说。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.05.03.dialogue",
          "type": "dialogue",
          "text": "收信人在1650年就已经——",
          "speaker_id": "npc_yan_yan",
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.05.04.narration",
          "type": "narration",
          "text": "她没说下去。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.06.01",
          "type": "narration",
          "text": "你打开信封。里面只有三行字。最后一行被什么液体洇开了——不像是水，是比水更咸的东西。",
          "speaker_id": null,
          "when": null
        },
        {
          "id": "S6.entry.default.paragraph.07.01",
          "type": "narration",
          "text": "_\"你等了两百七十五年。我让你等了更久。对不起。\"_",
          "speaker_id": null,
          "when": null
        }
      ]
    }
  ],
