{
  "$defs": {
    "AuthoringSpec": {
      "additionalProperties": false,
      "description": "编剧和编辑器使用、暂不直接驱动播放器的结构化元数据。",
      "properties": {
        "linked_sub_nodes": {
          "items": {
            "type": "object"
          },
          "title": "Linked Sub Nodes",
          "type": "array"
        },
        "npcs_present": {
          "items": {
            "type": "string"
          },
          "title": "Npcs Present",
          "type": "array"
        },
        "scene_items": {
          "items": {
            "type": "object"
          },
          "title": "Scene Items",
          "type": "array"
        },
        "npc_item_mapping": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "items": {},
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Npc Item Mapping"
        },
        "sensory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensory"
        },
        "gender_variant": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gender Variant"
        }
      },
      "title": "AuthoringSpec",
      "type": "object"
    },
    "ContentBlock": {
      "additionalProperties": false,
      "description": "播放器可顺序消费的最小内容单元。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "narration",
            "dialogue",
            "system"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker Id"
        },
        "when": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "type",
        "text"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "EntrySequence": {
      "additionalProperties": false,
      "description": "进入节点时按条件选中的内容序列。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "blocks"
      ],
      "title": "EntrySequence",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "description": "选择播放结果后的导航行为。",
      "properties": {
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "stay",
            "travel",
            "shortcut",
            "warp"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "mode"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "RoutingSpec": {
      "additionalProperties": false,
      "description": "莫比乌斯跨面、J 捷径和 K 跃迁配置。",
      "properties": {
        "crossing": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crossing"
        },
        "shortcut": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shortcut"
        },
        "warp": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warp"
        }
      },
      "title": "RoutingSpec",
      "type": "object"
    },
    "SceneSpec": {
      "additionalProperties": false,
      "description": "不参与剧情规则的场景表现配置。",
      "properties": {
        "background": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Background"
        },
        "palette": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Palette"
        },
        "ambient": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ambient"
        },
        "atmosphere": {
          "items": {
            "type": "string"
          },
          "title": "Atmosphere",
          "type": "array"
        }
      },
      "title": "SceneSpec",
      "type": "object"
    },
    "StoryChoiceV2": {
      "additionalProperties": false,
      "description": "与所属节点共置的选择和结果内容。",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "short_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Label"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "locked_visibility": {
          "default": "show",
          "enum": [
            "show",
            "hide"
          ],
          "title": "Locked Visibility",
          "type": "string"
        },
        "repeat_policy": {
          "default": "once_per_visit",
          "enum": [
            "always",
            "once_per_visit",
            "once_per_cycle",
            "once_ever"
          ],
          "title": "Repeat Policy",
          "type": "string"
        },
        "priority": {
          "default": 99,
          "title": "Priority",
          "type": "integer"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "result_blocks": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "title": "Result Blocks",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/StoryEffectV2"
          },
          "title": "Effects",
          "type": "array"
        },
        "next": {
          "$ref": "#/$defs/NextAction"
        }
      },
      "required": [
        "id",
        "label",
        "next"
      ],
      "title": "StoryChoiceV2",
      "type": "object"
    },
    "StoryEffectV2": {
      "additionalProperties": false,
      "description": "结构化游戏效果；显示文本不得代替效果数据。",
      "properties": {
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "type"
      ],
      "title": "StoryEffectV2",
      "type": "object"
    },
    "StoryNodeMeta": {
      "additionalProperties": false,
      "description": "节点身份、拓扑与展示标题。",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "node_type": {
          "enum": [
            "main",
            "normal",
            "special_shortcut",
            "special_warp"
          ],
          "title": "Node Type",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "number"
        },
        "time_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Label"
        },
        "parent_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Node Id"
        },
        "trigger_condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Condition"
        }
      },
      "required": [
        "name",
        "node_type",
        "position"
      ],
      "title": "StoryNodeMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "单文件内聚的 v2 故事节点。",
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/StoryNodeMeta"
    },
    "scene": {
      "$ref": "#/$defs/SceneSpec"
    },
    "entry_sequences": {
      "items": {
        "$ref": "#/$defs/EntrySequence"
      },
      "minItems": 1,
      "title": "Entry Sequences",
      "type": "array"
    },
    "choices": {
      "items": {
        "$ref": "#/$defs/StoryChoiceV2"
      },
      "title": "Choices",
      "type": "array"
    },
    "routing": {
      "$ref": "#/$defs/RoutingSpec"
    },
    "authoring": {
      "$ref": "#/$defs/AuthoringSpec"
    }
  },
  "required": [
    "id",
    "meta",
    "entry_sequences"
  ],
  "title": "StoryNodeV2",
  "type": "object"
}
