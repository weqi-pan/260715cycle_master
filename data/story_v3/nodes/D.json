      "result": [
        {
          "id": "D_choice_06_result_paragraph_01_01",
          "text": "南塔的自动门在夜晚依然开着——服装店的模特在橱窗里摆着僵硬的姿势。你走过它们时忍不住回头看了一眼——确认它们还是塑料的。二楼的灯光比一楼暗，走廊尽头有一面落地镜，镜面反射出的画面似乎比周围的光线慢了一点点。你朝它走去。",
          "type": "narration",
          "when": null
        }
      ],
      "short_text": "南塔商场",
      "text": "前往南塔商场看看"
    },
    {
      "availability": {
        "condition": null,
        "locked_reason": null,
        "locked_visibility": "show"
      },
      "effects": [],
      "hint": null,
      "id": "D_choice_07",
      "next": {
        "mode": "travel",
