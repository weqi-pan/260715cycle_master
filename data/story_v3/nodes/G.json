      "id": "G_choice_06",
      "next": {
        "mode": "travel",
        "target": "S13"
      },
      "repeat_policy": "once_per_visit",
      "result": [
        {
          "id": "G_choice_06_result_paragraph_01_01",
          "text": "陈家祠北面隔两条街就是荔湾湖。你朝那个方向走——不是因为你有什么计划，是因为你需要水。每一个接近时间裂隙的人都会本能地寻找水——水是时间的天然镜子，从江到湖到井，荔湾的水系在地下连通着龙脉，水面上映出的不是天空，是时间的倒影。",
          "type": "narration",
          "when": null
        }
      ],
      "short_text": "荔湾湖",
      "text": "前往荔湾湖公园"
    },
    {
      "availability": {
        "condition": null,
        "locked_reason": null,
        "locked_visibility": "show"
      },
      "effects": [],
      "hint": null,
      "id": "G_choice_07",
      "next": {
