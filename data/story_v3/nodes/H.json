      "repeat_policy": "once_per_visit",
      "result": [
        {
          "id": "H_choice_01_result_paragraph_01_01",
          "text": "张天民把整本笔记本塞进你手里——不是撕一页，是整本。A5软皮，八十页。封面被翻得起了毛边，书脊裂了用透明胶粘过。本子的重量比看起来要轻——纸被翻过太多次，纤维都松了。",
          "type": "narration",
          "when": null
        },
        {
          "id": "H_choice_01_result_paragraph_02_01",
          "speaker_id": "npc_zhang_tianmin",
          "text": "我写了55天。每一天的时间线、异常记录、八个节点的状态变化。里面有我走过的每一条路、见过的每一个人、每一次尝试逃跑的路线。全都在这里。",
          "type": "dialogue",
          "when": null
        },
        {
          "id": "H_choice_01_result_paragraph_03_01",
          "text": "你翻开第一页。第一行字——笔迹很工整，是第一天写的——\"如果你看到这个，说明我失败了。但你还有机会。我叫张天民。室内设计师。广州人。3月24号来的。今天是第1天。\"后面每一页的字迹越来越潦草——从端正的楷书到几乎可以称为草书的连笔。55天的重量不是数字——是笔画的退化过程。",
          "type": "narration",
          "when": null
        },
        {
          "id": "H_choice_01_result_paragraph_04_01",
          "text": "最后一页不是数据——是一行孤零零的字，写在页脚：\"下一次循环如果我不记得给你笔记——请你自己去糖水铺找。我把它压在靠窗第二张桌子的桌脚下。\"他连自己会忘记都预判了。他为自己的遗忘做了备份。",
          "type": "narration",
          "when": null
        },
        {
          "id": "H_choice_01_result_paragraph_05_01",
          "speaker_id": "npc_zhang_tianmin",
          "text": "走吧。你还有机会。我——我可能还有第56天。",
          "type": "dialogue",
          "when": null
        }
      ],
      "short_text": "接受笔记",
      "text": "接受张天民的完整笔记本"
    },
    {
      "availability": {
        "condition": null,
        "locked_reason": null,
        "locked_visibility": "show"
      },
      "effects": [
        {
          "item_id": "item_loop_newspaper",
          "operation": "add",
